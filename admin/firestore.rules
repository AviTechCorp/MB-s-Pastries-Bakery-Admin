rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mbspastriesandbakery@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /sites/mbs-pastries-and-bakery {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'bulk',
          'singles',
          'gallery',
          'settings',
          'updatedAt'
        ])
        && !request.resource.data.settings.keys().hasAny([
          'password',
          'adminPassword'
        ]);
      allow delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll([
          'product',
          'qty',
          'note',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'product',
          'qty',
          'note',
          'status',
          'createdAt'
        ])
        && request.resource.data.product is string
        && request.resource.data.product.size() > 0
        && request.resource.data.product.size() <= 200
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1
        && request.resource.data.qty <= 99
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
